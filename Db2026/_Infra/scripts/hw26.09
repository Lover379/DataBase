DROP TABLE "старые параметры";


SELECT
    p."дата_измерения" AS "Дата измерения",
    p.code AS "Номер пачки",
    u.name AS "ФИО сотрудника",
    t.name || ', ' || e.name AS "Наименование параметра и ед. измерения",
    param."значение" AS "Значение"

FROM "параметры" param

JOIN "пачки" p
    ON param."пачка_code" = p.code

JOIN "пользователи" u
    ON p."пользователь_code" = u.code

JOIN "Типы параметров" t
    ON param."тип_параметра_code" = t.code

JOIN "Единицы измерения" e
    ON param."единица_измерения_code" = e.code;