    code,
    "высота_ДМК",
    "температура",
    "давление",
    "направление_ветра",
    "скорость_ветра"
FROM "параметры";


ALTER TABLE "пачки"
ADD COLUMN "дата_измерения" DATE;

UPDATE "пачки"
SET "дата_измерения" = DATE '2026-09-26';


ALTER TABLE "пачки"
DROP COLUMN "параметр_code";

DROP TABLE "параметры";


CREATE TABLE "Базовые единицы измерения"
(
    code INTEGER PRIMARY KEY,
    name VARCHAR(100)
);

CREATE TABLE "Единицы измерения"
(
    code INTEGER PRIMARY KEY,
    name VARCHAR(100),
    "базовая_единица_code" INTEGER,
    FOREIGN KEY ("базовая_единица_code")
        REFERENCES "Базовые единицы измерения"(code)
);

CREATE TABLE "Типы параметров"
(
    code INTEGER PRIMARY KEY,
    name VARCHAR(100)
);


