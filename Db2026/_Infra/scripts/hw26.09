CREATE TABLE "старые параметры"
(
    code INTEGER,
    "высота_ДМК" INTEGER,
    "температура" DECIMAL(4,1),
    "давление" INTEGER,
    "направление_ветра" INTEGER,
    "скорость_ветра" INTEGER
);

INSERT INTO "старые параметры"
(
    code,
    "высота_ДМК",
    "температура",
    "давление",
    "направление_ветра",
    "скорость_ветра"
)
