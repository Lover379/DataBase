CREATE TABLE "параметры"
(
    code INTEGER PRIMARY KEY,
    "тип_параметра_code" INTEGER,
    "единица_измерения_code" INTEGER,
    "пачка_code" INTEGER,
    "значение" DECIMAL(10,2),

    FOREIGN KEY ("тип_параметра_code")
        REFERENCES "Типы параметров"(code),

    FOREIGN KEY ("единица_измерения_code")
        REFERENCES "Единицы измерения"(code),

    FOREIGN KEY ("пачка_code")
        REFERENCES "пачки"(code)
);


