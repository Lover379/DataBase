INSERT INTO "пачки"
    (code, name, "пользователь_code", "тип_оборудования_code")
VALUES
    (1, 'Пачка №1', 1, 1),
    (2, 'Пачка №2', 2, 2),
    (3, 'Пачка №3', 3, 3);


SELECT
    p.code AS "Код пачки",
    p.name AS "Пачка",
    u.code AS "Код пользователя",
    u.name AS "Пользователь",
    d.name AS "Должность",
    e.name AS "Тип оборудования",
    param.name AS "Параметр",
    param."значение" AS "Значение"
FROM "пачки" p
JOIN "пользователи" u
    ON p."пользователь_code" = u.code
JOIN "должности" d
    ON u."должность_code" = d.code
JOIN "типы оборудования" e
    ON p."тип_оборудования_code" = e.code
JOIN "параметры" param
    ON e."параметр_code" = param.code;