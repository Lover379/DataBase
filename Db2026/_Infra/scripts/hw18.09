INSERT INTO "пачки"
(
    code,
    name,
    "пользователь_code",
    "тип_оборудования_code",
    "параметр_code"
)
VALUES
    (1, 'Пачка №1', 1, 1, 1),
    (2, 'Пачка №2', 2, 1, 2),
    (3, 'Пачка №3', 3, 2, 3);

SELECT
    p.name AS "Пачка",
    u.name AS "Пользователь",
    d.name AS "Должность",
    e.name AS "Тип оборудования",
    param."высота_ДМК" AS "Высота ДМК",
    param."температура" AS "Температура",
    param."давление" AS "Давление",
    param."направление_ветра" AS "Направление ветра",
    param."скорость_ветра" AS "Скорость ветра"

FROM "пачки" p

JOIN "пользователи" u
    ON p."пользователь_code" = u.code

JOIN "должности" d
    ON u."должность_code" = d.code

JOIN "типы оборудования" e
    ON p."тип_оборудования_code" = e.code

JOIN "параметры" param
    ON p."параметр_code" = param.code;