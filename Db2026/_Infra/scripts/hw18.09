DROP TABLE IF EXISTS "пачки";
DROP TABLE IF EXISTS "типы оборудования";
DROP TABLE IF EXISTS "параметры";
DROP TABLE IF EXISTS "пользователи";
DROP TABLE IF EXISTS "должности";


CREATE TABLE "должности"
(
    code INTEGER PRIMARY KEY,
    name VARCHAR(100)
);


CREATE TABLE "пользователи"
(
    code INTEGER PRIMARY KEY,
    name VARCHAR(100),
    "должность_code" INTEGER,
    FOREIGN KEY ("должность_code") REFERENCES "должности"(code)
);


CREATE TABLE "параметры"
(
    code INTEGER PRIMARY KEY,
    "высота_ДМК" INTEGER,
    "температура" DECIMAL(4,1),
    "давление" INTEGER,
    "направление_ветра" INTEGER,
    "скорость_ветра" INTEGER
);


CREATE TABLE "типы оборудования"
(
    code INTEGER PRIMARY KEY,
    name VARCHAR(100)
);


CREATE TABLE "пачки"
(
    code INTEGER PRIMARY KEY,
    name VARCHAR(100),
    "пользователь_code" INTEGER,
    "тип_оборудования_code" INTEGER,
    "параметр_code" INTEGER,

    FOREIGN KEY ("пользователь_code")
        REFERENCES "пользователи"(code),

    FOREIGN KEY ("тип_оборудования_code")
        REFERENCES "типы оборудования"(code),

    FOREIGN KEY ("параметр_code")
        REFERENCES "параметры"(code)
);


